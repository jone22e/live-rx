# ---- backend ----
PORT=3005
HOST=0.0.0.0
LOG_LEVEL=info
# JSON com a lista de servidores ICE. Vazio = STUN público do Google.
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"turn:turn.exemplo.com:3478","username":"u","credential":"p"}]
MAX_ROOMS=1000
MAX_PARTICIPANTS_PER_ROOM=50
# Sala vazia é removida depois deste tempo (tolerância para reconexões)
EMPTY_ROOM_GRACE_MS=10000
# Token da API REST de integração (Authorization: Bearer <token>). Vazio = API desabilitada.
# API_TOKEN=troque-por-um-segredo-longo
# URL pública do site, usada nos links devolvidos pela API
# PUBLIC_URL=https://live.exemplo.com
HEARTBEAT_INTERVAL_MS=25000
# Lista de origens permitidas no WebSocket, separadas por vírgula. Vazio = todas.
# ALLOWED_ORIGINS=https://live.exemplo.com

# ---- servidor de mídia (mediasoup) ----
# IP pelo qual os navegadores alcançam o servidor. Em produção/Docker é obrigatório o IP público;
# em desenvolvimento, se vazio, usa o IP da máquina na rede local.
# MEDIASOUP_ANNOUNCED_IP=203.0.113.10
MEDIASOUP_LISTEN_IP=0.0.0.0
# Porta única de mídia (UDP e TCP) compartilhada por todos os participantes
MEDIASOUP_RTC_PORT=40000

# ---- frontend (somente em build/dev) ----
# Por padrão o frontend usa ws(s)://<mesma origem>/ws. Defina só se o backend estiver em outro host.
# VITE_WS_URL=wss://api.exemplo.com/ws

# ---- docker compose (servidor) ----
# Veja deploy/.env.server.example: WEB_PORT=3012, MEDIASOUP_ANNOUNCED_IP, API_TOKEN, PUBLIC_URL
