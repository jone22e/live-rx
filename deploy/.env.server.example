# Copie para /caminho/do/projeto/.env no servidor e ajuste.

# Porta HTTP publicada pelo compose (site + /ws + /api). O proxy reverso aponta para ela.
WEB_PORT=3012

# IP público real do servidor. Os navegadores enviam e recebem mídia direto para este IP
# nas portas UDP/TCP 40000-40100. Não use o IP do Cloudflare nem de um balanceador.
MEDIASOUP_ANNOUNCED_IP=203.0.113.10

# Token da API REST usada pelo Flexi (Authorization: Bearer <token>). Gere um valor longo e aleatório:
#   openssl rand -hex 32
API_TOKEN=troque-por-um-segredo-longo

# URL pública do site, usada nos links devolvidos pela API.
PUBLIC_URL=https://live.exemplo.com

# Opcionais
LOG_LEVEL=info
MAX_PARTICIPANTS_PER_ROOM=50
EMPTY_ROOM_GRACE_MS=10000
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
