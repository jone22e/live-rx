# Copie para /caminho/do/projeto/.env no servidor e ajuste.

# Porta HTTP publicada pelo compose (site + /ws + /api). O proxy reverso aponta para ela.
WEB_PORT=3012

# Endereço público pelo qual os navegadores enviam e recebem mídia, na porta MEDIASOUP_RTC_PORT (UDP e TCP).
# Na AWS com instância privada: o IP elástico do Network Load Balancer que encaminha essa porta para a instância.
# Servidor com IP público próprio: esse IP. Nunca o IP do Cloudflare.
MEDIASOUP_ANNOUNCED_IP=203.0.113.10
MEDIASOUP_RTC_PORT=40000

# Token da API REST usada pelo Flexi (Authorization: Bearer <token>). Gere um valor longo e aleatório:
#   openssl rand -hex 32
API_TOKEN=troque-por-um-segredo-longo

# URL pública do site, usada nos links devolvidos pela API.
PUBLIC_URL=https://live.exemplo.com

# Origens aceitas no WebSocket de signaling, separadas por vírgula (esquema + domínio, sem barra no final).
# Vazio = todas. No iframe dentro do Flexi a origem continua sendo a do Screen Live.
ALLOWED_ORIGINS=https://live.exemplo.com

# Opcionais
LOG_LEVEL=info
MAX_PARTICIPANTS_PER_ROOM=50
EMPTY_ROOM_GRACE_MS=10000
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
